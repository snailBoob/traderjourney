{
  "name": "traderjourney-monorepo",
  "private": true,
  "description": "TraderJourney: a self-hosted trading journal with broker sync, performance reports and daily reviews.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snailBoob/traderjourney.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "preview": "pnpm build && pnpm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "version": "1.2.1"
}
